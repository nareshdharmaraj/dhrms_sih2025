# DHRMS Backend Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_BASE_URL=http://localhost:3000/api
CLOUD_API_URL=https://your-app-name.onrender.com/api
USE_CLOUD_SERVER=false

# MongoDB Configuration
MONGODB_URI=mongodb+srv://saravana:saravana100@cluster0.52eru2s.mongodb.net/myhealth?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_PATH=./uploads

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Encryption Keys
ENCRYPTION_KEY=your_32_character_encryption_key

# External APIs
HEALTHCARE_API_KEY=your_healthcare_api_key
NOTIFICATION_SERVICE_KEY=your_notification_key
