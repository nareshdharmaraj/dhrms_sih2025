# DHRMS Backend Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_BASE_URL=http://localhost:3000/api
CLOUD_API_URL=https://your-app-name.onrender.com/api
USE_CLOUD_SERVER=false

# MongoDB Configuration
MONGODB_URI=mongodb+srv://saravana:saravana100@cluster0.52eru2s.mongodb.net/myhealth?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# WHO Admin JWT Configuration
WHO_JWT_SECRET=who-admin-jwt-secret-change-this-in-production
WHO_SESSION_TIMEOUT=24h
WHO_MAX_LOGIN_ATTEMPTS=5
WHO_LOCK_DURATION=30

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_PATH=./uploads

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# WHO System Rate Limiting
WHO_RATE_LIMIT_REQUESTS=100
WHO_RATE_LIMIT_WINDOW=900000

# Encryption Keys
ENCRYPTION_KEY=your_32_character_encryption_key

# Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# External APIs
HEALTHCARE_API_KEY=your_healthcare_api_key
NOTIFICATION_SERVICE_KEY=your_notification_key

# WHO System Configuration
WHO_SYSTEM_NAME=WHO India Health Management System
WHO_CONTACT_EMAIL=support@who-india.org
WHO_SUPPORT_PHONE=+91-11-12345678

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_MONITORING=true
HEALTH_CHECK_INTERVAL=60000
