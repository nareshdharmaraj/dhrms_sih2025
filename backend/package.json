{
  "name": "dhrms-backend",
  "version": "1.0.0",
  "description": "Digital Health Record Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "debug": "nodemon --inspect src/server.js",
    "start:local": "node -r dotenv/config src/server.js dotenv_config_path=.env.local",
    "dev:local": "nodemon -r dotenv/config src/server.js dotenv_config_path=.env.local",
    "debug:local": "nodemon --inspect -r dotenv/config src/server.js dotenv_config_path=.env.local",
    "test": "jest",
    "test:who": "node scripts/testWhoSystem.js",
    "setup:who": "node scripts/createWhoAdmin.js",
    "lint": "eslint src/"
  },
  "keywords": [
    "healthcare",
    "dhrms",
    "nodejs",
    "express",
    "mongodb",
    "api"
  ],
  "author": "SIH 2025 Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "qrcode": "^1.5.4",
    "redis": "^4.6.7",
    "socket.io": "^4.7.2",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
