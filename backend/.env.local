# Local Debug Environment Configuration
# This file is used for local development and debugging
# It doesn't affect the cloud deployment

# MongoDB Configuration - Using Main Database
MONGODB_URI=mongodb+srv://saravana:saravana100@cluster0.52eru2s.mongodb.net/myhealth?retryWrites=true&w=majority&appName=Cluster0

# Server Configuration - Local Debug
PORT=3000
NODE_ENV=development

# API Configuration - Local Debug
API_BASE_URL=http://localhost:3000/api
CLOUD_API_URL=https://dhrms-sih2025.onrender.com/api
USE_CLOUD_SERVER=false

# Debug Mode Settings
DEBUG_MODE=true
VERBOSE_LOGGING=true
CORS_ORIGIN=*

# Database Configuration - Debug
DB_NAME=myhealth_debug
DB_CONNECTION_NAME=debug_local

# JWT Configuration - Debug (separate keys)
JWT_SECRET=debug_local_jwt_secret_key_for_development
JWT_EXPIRES_IN=24h

# WHO Admin JWT Configuration - Debug
WHO_JWT_SECRET=who-admin-debug-jwt-secret-local-development
WHO_SESSION_TIMEOUT=24h
WHO_MAX_LOGIN_ATTEMPTS=10
WHO_LOCK_DURATION=15

# WHO System Rate Limiting - Relaxed for debug
WHO_RATE_LIMIT_REQUESTS=1000
WHO_RATE_LIMIT_WINDOW=900000

# Security Configuration - Debug
BCRYPT_ROUNDS=8
PASSWORD_MIN_LENGTH=6

# WHO System Configuration - Debug
WHO_SYSTEM_NAME=WHO India Health Management System (Debug)
WHO_CONTACT_EMAIL=debug@who-india.org
WHO_SUPPORT_PHONE=+91-11-12345678

# Email Configuration - Debug
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=debug_email@gmail.com
EMAIL_PASS=debug_app_password

# Debug-specific settings
LOG_LEVEL=debug
ENABLE_DEBUG_ROUTES=true
SHOW_STACK_TRACES=true